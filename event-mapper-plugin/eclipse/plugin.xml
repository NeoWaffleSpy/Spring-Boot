<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Window > Show View > Other... > Event Mapper > Event Map -->
   <extension point="org.eclipse.ui.views">
      <category id="com.eventmapper.eclipse.views" name="Event Mapper"/>
      <view id="com.eventmapper.eclipse.view"
            category="com.eventmapper.eclipse.views"
            class="com.eventmapper.eclipse.EventMapView"
            name="Event Map"
            restorable="true"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <category id="com.eventmapper.eclipse.category" name="Event Mapper"/>
      <command id="com.eventmapper.eclipse.show"
               categoryId="com.eventmapper.eclipse.category"
               name="Show Event Map"
               description="Open the Event Map view on the selected projects (all Java projects if none is selected)"/>
      <command id="com.eventmapper.eclipse.export"
               categoryId="com.eventmapper.eclipse.category"
               name="Export Event Map"
               description="Write the event map of the selected projects to an HTML page or a JSON file"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="com.eventmapper.eclipse.show" class="com.eventmapper.eclipse.ShowEventMapHandler"/>
      <handler commandId="com.eventmapper.eclipse.export" class="com.eventmapper.eclipse.ExportEventMapHandler"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <!-- Project menu -->
      <menuContribution locationURI="menu:project?after=additions">
         <command commandId="com.eventmapper.eclipse.show" label="Show Event Map"/>
         <command commandId="com.eventmapper.eclipse.export" label="Export Event Map..."/>
      </menuContribution>
      <!-- right-click on projects in the Package / Project Explorer -->
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="com.eventmapper.eclipse.show" label="Show Event Map">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <and>
                     <count value="+"/>
                     <iterate ifEmpty="false" operator="and">
                        <adapt type="org.eclipse.core.resources.IProject"/>
                     </iterate>
                  </and>
               </with>
            </visibleWhen>
         </command>
         <command commandId="com.eventmapper.eclipse.export" label="Export Event Map...">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <and>
                     <count value="+"/>
                     <iterate ifEmpty="false" operator="and">
                        <adapt type="org.eclipse.core.resources.IProject"/>
                     </iterate>
                  </and>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

</plugin>
